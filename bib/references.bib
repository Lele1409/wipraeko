@book{vossWissenschaftlichesArbeitenLeicht2024,
  title = {{Wissenschaftliches Arbeiten: ... leicht verst{\"a}ndlich!}},
  shorttitle = {{Wissenschaftliches Arbeiten}},
  author = {Voss, R{\"o}diger},
  year = {2024},
  month = jul,
  edition = {9},
  publisher = {utb GmbH},
  address = {Stuttgart, Deutschland},
  doi = {10.36198/9783838588322},
  urldate = {2024-11-26},
  abstract = {Wissenschaftlich arbeiten -- wie geht das eigentlich in Zeiten von Wikipedia und KI? Diese zentrale Frage stellen sich Studierende mindestens einmal w{\"a}hrend ihres Studiums. R{\"o}diger Voss geht auf die Herausforderungen ein, die sich vor, w{\"a}hrend und nach einer wissenschaftlichen Arbeit ergeben. Dazu z{\"a}hlen die Themenfindung, das Zeitmanagement, die Recherche, die Zitierweise, die Lese- und Schreibtechniken sowie die inhaltliche und formale Gestaltung von wissenschaftlichen Arbeiten. Durch aktuelle Beispiele, Tabellen und Merkhilfen vermittelt der Autor alles Wissenswerte und bietet einen leicht verst{\"a}ndlichen Leitfaden. Auf den richtigen Umgang mit K{\"u}nstlicher Intelligenz sowie auf das korrekte Zitieren von z. B. Wikipedia, Statista und YouTube geht er zudem ein. Das Buch, nun in der neunten Auflage, ist ein hilfreiches Must-have f{\"u}r Studierende der Wirtschafts-, Sozial- und Erziehungswissenschaften.},
  isbn = {978-3-8385-8832-2},
  langid = {ngerman}
}

